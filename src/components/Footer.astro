---
import Icon from './Icon.astro';
import pkg from '../../package.json';
import { content, type Locale } from '../i18n/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale].footer;
const year = new Date().getFullYear();
---

<footer class="container footer">
  <span class="version">v{pkg.version}</span>
  <p class="made">
    {t.madeWith}
    <span class="heart"><Icon name="heart" size={16} label={t.love} /></span>
    {t.by} <strong>Diego González</strong>
  </p>
  <p class="copy">© {year}</p>
</footer>

<!-- Volver arriba: aparece al bajar por la pagina -->
<div class="to-top" id="to-top" hidden>
  <dgonmej-ui-button variant="glass" icon href="#main" label={t.top}>
    <Icon name="arrow-up" />
  </dgonmej-ui-button>
</div>

<script>
  const toTop = document.getElementById('to-top')!;
  toTop.hidden = false;
  const update = () => toTop.classList.toggle('visible', window.scrollY > window.innerHeight * 0.6);
  window.addEventListener('scroll', update, { passive: true });
  update();
</script>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--ui-space-2) var(--ui-space-6);
    /* Margen inferior: el boton de volver arriba (44px) no tapa el texto al final de la pagina */
    padding-block: var(--ui-space-6) calc(44px + var(--ui-space-8) + env(safe-area-inset-bottom));
    border-top: 1px solid var(--ui-color-separator);
    color: var(--ui-color-text-muted);
    font-size: var(--ui-font-size-footnote);
  }

  .footer p {
    margin: 0;
  }

  .made {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 6px;
    color: var(--ui-color-text);
    font-size: var(--ui-font-size-subhead);
  }

  .made strong {
    color: var(--ui-color-primary-text);
  }

  /* Corazon relleno con el acento */
  .heart {
    display: inline-flex;
    color: var(--ui-color-primary-text);
  }

  .heart :global(.icon) {
    fill: currentColor;
  }

  .version {
    padding: 2px 10px;
    border-radius: var(--ui-radius-control);
    color: var(--ui-color-primary-text);
    background: var(--ui-color-primary-tint);
    font-size: var(--ui-font-size-caption);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 559px) {
    .footer {
      flex-direction: column;
    }
  }

  .to-top {
    position: fixed;
    z-index: 20;
    right: calc(var(--ui-space-4) + env(safe-area-inset-right));
    bottom: calc(var(--ui-space-4) + env(safe-area-inset-bottom));
    opacity: 0;
    transform: translateY(8px) scale(0.96);
    pointer-events: none;
    transition:
      opacity var(--ui-duration-base) var(--ui-ease-standard),
      transform var(--ui-duration-base) var(--ui-ease-standard);
  }

  .to-top:global(.visible) {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .to-top {
      transform: none;
    }
  }
</style>
