---
import { Image } from 'astro:assets';
// Sin pupilas: las pintan encima los ojos que siguen al ratón (scripts/eyes.mjs las prepara)
import avatarLight from '../assets/avatar-light-no-pupils.png';
import avatarDark from '../assets/avatar-dark-no-pupils.png';
import ojos from '../lib/eyes.json';
import mascaraClaro from '../assets/eyes-mask-light.png?url';
import mascaraOscuro from '../assets/eyes-mask-dark.png?url';
import Icon from './Icon.astro';
import { content, email, socials, type Locale } from '../i18n/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale].hero;

// Ojos de cada versión de la ilustración (están unos píxeles desplazados): pupilas que siguen al ratón y
// párpados que bajan al parpadear, en % del avatar. Cada pupila sabe su reposo (como en el dibujo), el
// centro de su ojo y cuánto se puede mover desde él (en píxeles del avatar).
const pct = (v: number, total: number) => `${((v / total) * 100).toFixed(3)}%`;
type Ojo = { centro: number[]; ancho: number; alto: number; reposo: number[] };
const capaDeOjos = (lista: Ojo[]) => ({
  pupilas: lista.map((o) => ({
    x: pct(o.reposo[0], ojos.ancho),
    y: pct(o.reposo[1], ojos.alto),
    cx: o.centro[0] - o.reposo[0],
    cy: o.centro[1] - o.reposo[1],
    // Casi tan alta como el ojo, como en el dibujo
    r: pct(o.alto * 0.78, ojos.ancho),
    mx: o.ancho / 2 - o.alto * 0.42,
    my: o.alto * 0.12,
  })),
  parpados: lista.map((o) => ({
    x: pct(o.centro[0] - o.ancho / 2 - 1, ojos.ancho),
    y: pct(o.centro[1] - o.alto / 2 - 1, ojos.alto),
    w: pct(o.ancho + 2, ojos.ancho),
    h: pct(o.alto + 2, ojos.alto),
  })),
});
const capas = [
  { tema: 'light', mascara: mascaraClaro, ...capaDeOjos(ojos.light) },
  { tema: 'dark', mascara: mascaraOscuro, ...capaDeOjos(ojos.dark) },
];
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="intro">
    <p class="greeting">{t.greeting}</p>
    <h1 id="hero-title">Diego González</h1>
    <p class="handle">@dgonmej</p>

    <ul class="facts">
      <li>
        <dgonmej-ui-icon name="briefcase" size="18"></dgonmej-ui-icon>
        {t.role}
      </li>
      <li>
        <Icon name="map-pin" size={18} />
        {t.location}
      </li>
    </ul>

    <p class="bio">{t.bio}</p>

    <div class="actions">
      <dgonmej-ui-button variant="primary" size="large" href={`mailto:${email}`}>
        <Icon name="mail" />{t.cta}
      </dgonmej-ui-button>
      <div class="socials">
        {
          socials.map((s) => (
            <dgonmej-ui-button variant="secondary" size="large" icon href={s.href} target="_blank" label={s.name}>
              <Icon name={s.icon} />
            </dgonmej-ui-button>
          ))
        }
      </div>
    </div>
  </div>

  <div class="portrait">
    <div class="cara" data-mirada>
      <Image class="avatar avatar-light" src={avatarLight} alt={t.avatarAlt} width={480} loading="eager" />
      <!-- Misma ilustracion en version oscura: decorativa para no leerla dos veces -->
      <Image class="avatar avatar-dark" src={avatarDark} alt="" width={480} loading="eager" />
      <!-- Pupilas y párpados encima, recortados con la forma de cada ojo (src/assets/eyes-mask-*.png) -->
      {
        capas.map((c) => (
          <div class={`pupilas pupilas-${c.tema}`} aria-hidden="true" style={`--mascara: url(${c.mascara})`}>
            {c.pupilas.map((p) => (
              <span
                class="pupila"
                style={`--x: ${p.x}; --y: ${p.y}; --r: ${p.r}`}
                data-cx={p.cx}
                data-cy={p.cy}
                data-mx={p.mx}
                data-my={p.my}
              />
            ))}
            {c.parpados.map((p) => (
              <span class="parpado" style={`left: ${p.x}; top: ${p.y}; width: ${p.w}; height: ${p.h}`} />
            ))}
          </div>
        ))
      }
    </div>
    <button class="mirada-boton" type="button" aria-pressed="true" title={t.gazeOn} hidden>
      <dgonmej-ui-icon name="eye" size="16"></dgonmej-ui-icon>
      <span>{t.gazeLabel}</span>
      <span class="sr-only">: {t.gazeOn}</span>
    </button>
    <div class="glass-tag" aria-hidden="true">
      <Icon name="map-pin" size={16} />
      {t.location}
    </div>
  </div>
</section>

<script>
  // Las pupilas miran hacia el ratón. Se puede apagar con el botón (se recuerda en este navegador);
  // con movimiento reducido empieza apagado.
  const CLAVE = 'whoami-mirada';
  const cara = document.querySelector<HTMLElement>('[data-mirada]');
  const boton = document.querySelector<HTMLButtonElement>('.mirada-boton');
  const pupilas = [...(cara?.querySelectorAll<HTMLElement>('.pupila') ?? [])];
  const conRaton = matchMedia('(hover: hover) and (pointer: fine)').matches;

  if (cara && boton && pupilas.length && conRaton) {
    let guardado: string | null = null;
    try {
      guardado = localStorage.getItem(CLAVE);
    } catch {}
    let activa = guardado ? guardado === '1' : !matchMedia('(prefers-reduced-motion: reduce)').matches;
    let pendiente = 0;
    let raton: { x: number; y: number } | null = null;

    // Escala del avatar en pantalla respecto a sus 480 px de ancho
    const escala = () => cara.getBoundingClientRect().width / 480;

    const reposo = () => {
      cara.classList.remove('sigue');
      for (const p of pupilas) p.style.removeProperty('--dx'), p.style.removeProperty('--dy');
    };

    const mirar = () => {
      pendiente = 0;
      if (!activa || !raton) return;
      const s = escala();
      cara.classList.add('sigue');
      for (const p of pupilas) {
        const caja = p.getBoundingClientRect();
        // Centro del ojo en pantalla (la pupila en reposo está desplazada respecto a él)
        const ox = caja.left + caja.width / 2 + Number(p.dataset.cx) * s - (parseFloat(p.style.getPropertyValue('--dx')) || 0);
        const oy = caja.top + caja.height / 2 + Number(p.dataset.cy) * s - (parseFloat(p.style.getPropertyValue('--dy')) || 0);
        const ang = Math.atan2(raton.y - oy, raton.x - ox);
        const cerca = Math.min(1, Math.hypot(raton.x - ox, raton.y - oy) / 160);
        const dx = (Number(p.dataset.cx) + Math.cos(ang) * Number(p.dataset.mx) * cerca) * s;
        const dy = (Number(p.dataset.cy) + Math.sin(ang) * Number(p.dataset.my) * cerca) * s;
        p.style.setProperty('--dx', `${dx.toFixed(2)}px`);
        p.style.setProperty('--dy', `${dy.toFixed(2)}px`);
      }
    };

    const alMover = (e: PointerEvent) => {
      raton = { x: e.clientX, y: e.clientY };
      if (!pendiente) pendiente = requestAnimationFrame(mirar);
    };

    // Parpadeo cada pocos segundos, a ritmo irregular y a veces doble, solo con la mirada activa
    const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const parpadear = () => {
      cara.classList.remove('parpadea');
      void cara.offsetWidth; // reinicia la animación
      cara.classList.add('parpadea');
    };
    cara.addEventListener('animationend', (e) => {
      if ((e as AnimationEvent).animationName.includes('parpadeo')) cara.classList.remove('parpadea');
    });
    const programarParpadeo = () => {
      setTimeout(() => {
        if (activa && !reducido && document.visibilityState === 'visible') {
          parpadear();
          if (Math.random() < 0.2) setTimeout(parpadear, 320);
        }
        programarParpadeo();
      }, 2500 + Math.random() * 3500);
    };
    if (!reducido) programarParpadeo();

    const pintarBoton = () => {
      boton.setAttribute('aria-pressed', String(activa));
      boton.querySelector('dgonmej-ui-icon')?.setAttribute('name', activa ? 'eye' : 'eye-off');
    };

    boton.hidden = false;
    pintarBoton();
    window.addEventListener('pointermove', alMover, { passive: true });
    document.documentElement.addEventListener('pointerleave', () => ((raton = null), reposo()));
    boton.addEventListener('click', () => {
      activa = !activa;
      try {
        localStorage.setItem(CLAVE, activa ? '1' : '0');
      } catch {}
      pintarBoton();
      if (activa) mirar();
      else reposo();
    });
  }
</script>

<style>
  .hero {
    display: grid;
    gap: var(--ui-space-8);
    align-items: center;
    padding-block: var(--ui-space-8) calc(var(--ui-space-8) * 1.5);
  }

  @media (min-width: 880px) {
    .hero {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      min-height: calc(100dvh - 120px);
    }
  }

  .greeting {
    margin: 0;
    color: var(--ui-color-primary-text);
    font-size: var(--ui-font-size-title3);
    font-weight: 600;
  }

  h1 {
    margin: var(--ui-space-1) 0 0;
    font-family: var(--ui-font-family-display);
    font-size: clamp(2.75rem, 7vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .handle {
    margin: var(--ui-space-2) 0 0;
    color: var(--ui-color-text-muted);
    font-size: var(--ui-font-size-title3);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--ui-space-2) var(--ui-space-5);
    margin: var(--ui-space-6) 0 0;
    padding: 0;
    list-style: none;
    font-weight: 600;
  }

  .facts li {
    display: inline-flex;
    align-items: center;
    gap: var(--ui-space-2);
  }

  .facts :global(.icon),
  .facts dgonmej-ui-icon {
    color: var(--ui-color-primary-text);
  }

  .bio {
    max-width: 32em;
    margin: var(--ui-space-4) 0 var(--ui-space-8);
    color: var(--ui-color-text-muted);
    font-size: var(--ui-font-size-title3);
    line-height: 1.45;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    /* Mas aire vertical cuando las redes bajan a otra linea */
    gap: var(--ui-space-5) var(--ui-space-3);
  }

  .socials {
    display: flex;
    gap: var(--ui-space-3);
  }

  /* Retrato: ilustracion sobre un degradado del acento */
  .portrait {
    position: relative;
    display: grid;
    place-items: end center;
    aspect-ratio: 4 / 5;
    width: min(100%, 420px);
    margin-inline: auto;
    overflow: hidden;
    border-radius: var(--ui-radius-lg);
    background: var(--site-portrait);
    box-shadow: var(--ui-shadow-lg);
    isolation: isolate;
  }

  /* La ilustración y sus pupilas, del mismo tamaño */
  .cara {
    position: relative;
    display: grid;
    grid-area: 1 / 1;
    width: 92%;
    aspect-ratio: 480 / 600;
    align-self: end;
  }

  .avatar {
    grid-area: 1 / 1;
    width: 100%;
    height: auto;
    transition: opacity var(--ui-duration-slow) var(--ui-ease-standard);
  }

  .pupilas {
    position: absolute;
    inset: 0;
    transition: opacity var(--ui-duration-slow) var(--ui-ease-standard);
    -webkit-mask: var(--mascara) 0 0 / 100% 100% no-repeat;
    mask: var(--mascara) 0 0 / 100% 100% no-repeat;
    pointer-events: none;
  }

  .pupila {
    position: absolute;
    top: var(--y);
    left: var(--x);
    width: var(--r);
    aspect-ratio: 1;
    margin: calc(var(--r) / -2) 0 0 calc(var(--r) / -2);
    border-radius: 50%;
    /* El gris de las pupilas del dibujo, con su raya oscura alrededor */
    background: #262626;
    box-shadow: 0 0 0 1.5px #080808;
    transform: translate(var(--dx, 0px), var(--dy, 0px));
    transition: transform var(--ui-duration-slow) var(--ui-ease-standard);
    will-change: transform;
  }

  /* Párpado: piel del dibujo con la línea del borde; espera encima del ojo (fuera de la máscara) */
  .parpado {
    position: absolute;
    background: linear-gradient(#e9d3c7 70%, #dcc2b6);
    box-shadow: inset 0 -2px 0 #111;
    transform: translateY(-105%);
  }

  .cara.parpadea .parpado {
    animation: parpadeo 240ms ease-in-out;
  }

  @keyframes parpadeo {
    45%,
    55% {
      transform: translateY(0);
    }
  }

  /* Siguiendo al ratón: respuesta rápida, sin el retardo de volver al reposo */
  .cara.sigue .pupila {
    transition-duration: 90ms;
  }

  .mirada-boton {
    position: absolute;
    right: var(--ui-space-4);
    bottom: var(--ui-space-4);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 36px;
    padding: 0 var(--ui-space-3);
    border: 1px solid var(--ui-material-border);
    border-radius: var(--ui-radius-pill);
    color: var(--ui-material-text);
    background: var(--ui-material-bg);
    box-shadow: var(--ui-shadow-sm);
    font: inherit;
    font-size: var(--ui-font-size-footnote);
    font-weight: 600;
    cursor: pointer;
    transition: transform var(--ui-duration-fast) ease-out, opacity var(--ui-duration-fast) ease-out;
  }

  .mirada-boton:active {
    transform: scale(0.97);
  }

  .mirada-boton:focus-visible {
    outline: 2px solid var(--ui-color-focus);
    outline-offset: 2px;
  }

  .mirada-boton[aria-pressed='false'] {
    opacity: 0.72;
  }

  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .mirada-boton {
      background: var(--ui-material-bg-translucent);
      -webkit-backdrop-filter: var(--ui-material-blur);
      backdrop-filter: var(--ui-material-blur);
    }
  }

  /* Sin ratón (pantallas táctiles) no hay a quién seguir: sin botón */
  @media (hover: none), (pointer: coarse) {
    .mirada-boton {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pupila {
      transition: none;
    }
    .cara.parpadea .parpado {
      animation: none;
    }
  }

  /* La ilustracion (y sus ojos) cambia con el tema, como en la version original */
  .avatar-dark,
  .pupilas-dark {
    opacity: 0;
  }

  :global([data-theme='dark']) .avatar-light,
  :global([data-theme='dark']) .pupilas-light {
    opacity: 0;
  }
  :global([data-theme='dark']) .avatar-dark,
  :global([data-theme='dark']) .pupilas-dark {
    opacity: 1;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .avatar-light,
    :global(:root:not([data-theme='light'])) .pupilas-light {
      opacity: 0;
    }
    :global(:root:not([data-theme='light'])) .avatar-dark,
    :global(:root:not([data-theme='light'])) .pupilas-dark {
      opacity: 1;
    }
  }

  .glass-tag {
    position: absolute;
    top: var(--ui-space-4);
    left: var(--ui-space-4);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px var(--ui-space-3);
    border-radius: var(--ui-radius-control);
    color: var(--ui-material-text);
    background: var(--ui-material-bg);
    border: 1px solid var(--ui-material-border);
    box-shadow: var(--ui-shadow-sm);
    font-size: var(--ui-font-size-footnote);
    font-weight: 600;
  }

  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .glass-tag {
      background: var(--ui-material-bg-translucent);
      -webkit-backdrop-filter: var(--ui-material-blur);
      backdrop-filter: var(--ui-material-blur);
    }
  }

  /* Va despues de los estilos base para poder sobrescribirlos.
     Movil en horizontal: poca altura, asi que texto y retrato lado a lado */
  @media (orientation: landscape) and (max-height: 520px) and (min-width: 600px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--ui-space-6);
      min-height: 0;
      padding-block: var(--ui-space-5) var(--ui-space-8);
    }
    .portrait {
      width: min(34vw, 280px);
    }
    h1 {
      font-size: clamp(2.25rem, 6vw, 3rem);
    }
    .facts {
      margin-top: var(--ui-space-4);
    }
    .bio {
      margin-bottom: var(--ui-space-5);
    }
  }

  /* Unico momento orquestado: entrada escalonada de la cabecera */
  @media (prefers-reduced-motion: no-preference) {
    .intro > *,
    .portrait {
      animation: reveal var(--ui-duration-slow) var(--ui-ease-standard) both;
    }
    .intro > :nth-child(2) {
      animation-delay: 40ms;
    }
    .intro > :nth-child(3),
    .intro > :nth-child(4) {
      animation-delay: 80ms;
    }
    .intro > :nth-child(5),
    .intro > :nth-child(6) {
      animation-delay: 120ms;
    }
    .portrait {
      animation-delay: 160ms;
    }
    @keyframes reveal {
      from {
        opacity: 0;
        transform: translateY(12px);
      }
    }
  }
</style>
