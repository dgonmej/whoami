---
import { content, type Locale } from '../i18n/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale].journey;

// Datos del timeline: hitos de inicio y fin alrededor de la trayectoria
const items = [
  { milestone: true, kind: 'start', ...t.start },
  ...t.items,
  { milestone: true, kind: 'end', ...t.end },
];
---

<section class="section container" id="trayectoria" aria-labelledby="journey-title">
  <div class="section-head">
    <h2 id="journey-title">{t.title}</h2>
    <p>{t.intro}</p>
  </div>

  <dgonmej-ui-timeline id="journey" label={t.timelineLabel} data-items={JSON.stringify(items)}>
    <!--
      Contenido en HTML plano: lo ven buscadores y quien navega sin JavaScript.
      Cuando el componente se activa, lo sustituye por su propio diseno.
    -->
    <ol class="fallback">
      {
        t.items.map((item) => (
          <li>
            <p class="period">{item.period}</p>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            {item.highlights && <p class="highlights">{item.highlights.join(', ')}</p>}
            {item.links && (
              <p>
                {item.links.map((link) => (
                  <a href={link.href} rel="noopener noreferrer">
                    {link.label}{' '}
                  </a>
                ))}
              </p>
            )}
          </li>
        ))
      }
    </ol>
  </dgonmej-ui-timeline>
</section>

<script>
  const timeline = document.getElementById('journey') as HTMLElement & { items: unknown };
  timeline.items = JSON.parse(timeline.dataset.items ?? '[]');
</script>

<style>
  .fallback {
    display: grid;
    gap: var(--ui-space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fallback li {
    padding: var(--ui-space-5);
    border-radius: var(--ui-radius-lg);
    background: var(--ui-color-surface);
    box-shadow: inset 0 0 0 1px var(--ui-color-border);
  }

  .fallback h3 {
    margin: var(--ui-space-1) 0;
    font-size: var(--ui-font-size-body);
  }

  .fallback p {
    margin: 0;
    color: var(--ui-color-text-muted);
  }

  .fallback .period {
    color: var(--ui-color-primary-text);
    font-weight: 600;
  }
</style>
