---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { content, locales, localeNames, type Locale } from '../i18n/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = content[locale];
const home = getRelativeLocaleUrl(locale, '');
const links = [
  { href: '#sobre-mi', label: t.nav.about },
  { href: '#tecnologias', label: t.nav.stack },
  { href: '#aficiones', label: t.nav.hobbies },
  { href: '#trayectoria', label: t.nav.journey },
];
// Opciones del selector de idioma: codigo visible, nombre completo para lectores de pantalla
const languages = locales.map((l) => ({ value: l, label: l.toUpperCase(), url: getRelativeLocaleUrl(l, '') }));
const other = locales.find((l) => l !== locale)!;
---

<dgonmej-ui-nav-bar class="site-nav" style="--ui-nav-bar-max-width: var(--site-max)">
  <!-- Firma de la familia dgonmej (manual en brand.dgonmej.com): tesela «dg» con la insignia >_ y la pastilla en Índigo -->
  <a slot="leading" class="brand" href={home} aria-label="whoami, de dgonmej: Diego González">
    <span class="brand-mark" aria-hidden="true">
      <b>dg</b>
      <span class="brand-badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"><path d="m4 17 6-6-6-6" /><path d="M12 19h8" /></svg>
      </span>
    </span>
    <span class="brand-name" aria-hidden="true"><span class="brand-family">dgonmej</span> <span class="brand-pill">whoami</span></span>
  </a>

  {
    links.map((l) => (
      <dgonmej-ui-button slot="trailing" class="wide-only" variant="ghost" size="small" href={l.href}>
        {l.label}
      </dgonmej-ui-button>
    ))
  }

  <dgonmej-ui-segmented-control
    slot="trailing"
    id="language"
    size="small"
    label={t.nav.language}
    value={locale}
    data-languages={JSON.stringify(languages)}
  ></dgonmej-ui-segmented-control>
  <noscript>
    <a slot="trailing" href={getRelativeLocaleUrl(other, '')} hreflang={other} lang={other}>{localeNames[other]}</a>
  </noscript>

  <!-- Segmentado solo con iconos en todas las anchuras: misma altura y estilo que el de idioma -->
  <dgonmej-ui-theme-toggle slot="trailing" compact></dgonmej-ui-theme-toggle>
</dgonmej-ui-nav-bar>

<script>
  // Selector de idioma: al cambiar, ir a la misma seccion en el otro idioma
  const language = document.getElementById('language') as HTMLElement & { options: unknown; value: string };
  const languages = JSON.parse(language.dataset.languages ?? '[]') as { value: string; label: string; url: string }[];
  customElements.whenDefined('dgonmej-ui-segmented-control').then(() => {
    language.options = languages.map(({ value, label }) => ({ value, label }));
  });
  language.addEventListener('ui-change', (event) => {
    const { value } = (event as CustomEvent<{ value: string }>).detail;
    const target = languages.find((l) => l.value === value);
    if (target) location.href = target.url + location.hash;
  });
</script>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding-inline: var(--ui-space-2);
    border-radius: var(--ui-radius-control);
    color: var(--ui-color-text);
    font-weight: 700;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  /* Colores de la marca (manual de marca: tinta y degradado Índigo de whoami) */
  .brand {
    --brand-ink: #0b1416;
    --brand-gradient: linear-gradient(135deg, #a5b4fc, #818cf8);
  }

  .brand-mark {
    position: relative;
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 9px;
    background:
      radial-gradient(90% 90% at 15% 0%, rgb(165 180 252 / 0.55), transparent 70%),
      radial-gradient(80% 80% at 100% 100%, rgb(129 140 248 / 0.45), transparent 70%),
      var(--brand-ink);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.08),
      0 4px 12px rgb(129 140 248 / 0.25);
  }

  .brand-mark b {
    font-size: 17px;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    transform: translateY(-1px);
    background: var(--brand-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .brand-badge {
    position: absolute;
    right: -4px;
    bottom: -4px;
    display: grid;
    place-items: center;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    color: var(--brand-ink);
    background: var(--brand-gradient);
    box-shadow: 0 0 0 2px var(--ui-color-background);
  }

  .brand-badge svg {
    width: 10px;
    height: 10px;
  }

  .brand-name {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--ui-font-size-title3);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .brand-pill {
    padding: 2px 8px 3px;
    border-radius: var(--ui-radius-pill);
    color: var(--brand-ink);
    background: var(--brand-gradient);
    font-size: 0.8em;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.2;
  }

  /* En móvil hay poco sitio junto al idioma y el tema: solo la tesela y la pastilla */
  @media (max-width: 479px) {
    .brand-family {
      display: none;
    }
    .brand-name {
      font-size: var(--ui-font-size-body);
    }
  }

  /* En los móviles más estrechos (320–379 px) no caben la pastilla, el idioma y el tema: solo la tesela
     (el enlace ya se llama «whoami, de dgonmej» para lectores de pantalla) */
  @media (max-width: 379px) {
    .brand-name {
      display: none;
    }
  }
</style>
